# ---------------------------------------------------------------------------
# Attack on Token V2 (QUOTIENT) — environment configuration
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Port the backend API listens on. V2-specific, so V1 can run side by side.
# Named API_PORT rather than PORT on purpose: tooling frequently sets PORT for
# the *frontend*, and the API inheriting it causes a port collision.
API_PORT=5179

# Absolute or relative path to the SQLite database file.
# Defaults to server/data/quotient-v2.db
DATABASE_PATH=server/data/quotient-v2.db

# --- AI provider (OPTIONAL) -------------------------------------------------
# ARBITER, the in-product support agent, runs in one of two modes:
#
#   1. "live"       — a real Anthropic model, used only when ANTHROPIC_API_KEY
#                     is set and reachable.
#   2. "deterministic" — a local, template-driven conversational engine.
#                     This is the DEFAULT and requires no credentials.
#
# The active mode is reported honestly by GET /api/arbiter/health and is
# displayed in the chat panel header. Leave this blank to use the fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Set to "deterministic" to force the local engine even if a key is present.
ARBITER_MODE=auto
